modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
KV_API_SECRET = "ad3932b770d947fb86fe7dd7136897ea89b37423175f4a8fbf3047dd920a9844"
VITE_KV_API_SECRET = "ad3932b770d947fb86fe7dd7136897ea89b37423175f4a8fbf3047dd920a9844"
