modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev & PORT=22133 BASE_PATH=/admin-dashboard/ pnpm --filter @workspace/admin-dashboard run dev & PORT=25357 BASE_PATH=/ pnpm --filter @workspace/requirement-doc run dev & PORT=23434 BASE_PATH=/customer-portal/ pnpm --filter @workspace/customer-portal run dev & PORT=23993 BASE_PATH=/tenant-store/ pnpm --filter @workspace/tenant-store run dev & wait"
waitForPort = 8080

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
KV_API_SECRET = "ad3932b770d947fb86fe7dd7136897ea89b37423175f4a8fbf3047dd920a9844"
VITE_KV_API_SECRET = "ad3932b770d947fb86fe7dd7136897ea89b37423175f4a8fbf3047dd920a9844"
